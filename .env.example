# Server Signing Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_32_bytes_hex_secret_here

# Special leader invite code (for Bùi Nhật Lệ or VIP recipient)
SPECIAL_LEADER_CODE=BLOOM-DEMO-2026

# Recipient configuration (JSON string or base64 encoded JSON string)
# Leave empty in public environments or populate on Vercel Dashboard / .env.local
RECIPIENTS_JSON=""

# Vercel Blob Read Write Token (PRIVATE store for personal photos — server/admin only)
BLOB_READ_WRITE_TOKEN=""

# Separate Vercel Blob Read Write Token (PUBLIC store for intro video upload script — admin only, NEVER expose via NEXT_PUBLIC)
INTRO_BLOB_READ_WRITE_TOKEN=""

# Optional Intro Video Public HTTPS Configuration (defaults to disabled in config/intro.ts until video is uploaded)
NEXT_PUBLIC_INTRO_ENABLED="false"
NEXT_PUBLIC_INTRO_VIDEO_URL=""
NEXT_PUBLIC_INTRO_POSTER_URL=""
NEXT_PUBLIC_INTRO_CAPTIONS_URL=""

