# Server Signing Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_32_bytes_hex_secret_here

# Special leader invite code (for Bùi Nhật Lệ or VIP recipient)
SPECIAL_LEADER_CODE=BLOOM-DEMO-2026

# Recipient configuration (JSON string or base64 encoded JSON string)
# Leave empty in public environments or populate on Vercel Dashboard / .env.local
RECIPIENTS_JSON=""

# Vercel Blob Read Write Token (optional, if using Vercel Blob store)
BLOB_READ_WRITE_TOKEN=""
